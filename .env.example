# Adzuna API credentials for live job search.
# 1. Create a free account at https://developer.adzuna.com/
# 2. Copy your Application ID and Application Key below.
# 3. Rename this file to ".env" (it is git-ignored, so your keys stay private).

ADZUNA_APP_ID=your_app_id_here
ADZUNA_APP_KEY=your_app_key_here

# Optional: set to 1 for local semantic (embeddings) matching.
# Requires: pip install -r requirements-semantic.txt  &&  python build_embeddings.py
# Leave at 0 on low-memory hosts (e.g. Render free tier) to use the classic matcher.
USE_SEMANTIC=0
